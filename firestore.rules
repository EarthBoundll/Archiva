rules_version = '2';

// ===============================================
// REGLAS DE SEGURIDAD — ARCHIVA
// ===============================================
//
// Las guardas del cliente son de experiencia: cualquiera puede saltárselas
// con las herramientas del navegador. La frontera real es esto.
//
// Modelo: los datos cuelgan de la empresa, no de la persona. La pertenencia
// —empresas/{eid}/miembros/{uid}— es lo que concede acceso y fija el rol.
//
// Para desplegar:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------
    // AYUDAS
    // -------------------------------------------

    function autenticado() {
      return request.auth != null;
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function miMembresia(eid) {
      return get(/databases/$(database)/documents/empresas/$(eid)/miembros/$(request.auth.uid)).data;
    }

    function existeMembresia(eid) {
      return autenticado() &&
             exists(/databases/$(database)/documents/empresas/$(eid)/miembros/$(request.auth.uid));
    }

    // Solo un miembro activo opera. Invitado y suspendido conservan su
    // historial pero no entran.
    // El rol que tiene quien pide, en esta empresa. Se lee una vez y se
    // reutiliza: cada get() dentro de una regla cuenta como lectura.
    function rolEn(eid) {
      return get(/databases/$(database)/documents/empresas/$(eid)/miembros/$(request.auth.uid)).data.rol;
    }

    // Una escritura que solo toca los campos indicados. Sirve para
    // conceder un permiso estrecho sin abrir el documento entero.
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // El correo con el que se autentico quien pide. Es lo que ata a la
    // cuenta recien creada con la invitacion que le corresponde.
    function miCorreo() {
      return autenticado() && request.auth.token.email != null
             ? request.auth.token.email.lower()
             : '';
    }

    function esMiembroActivo(eid) {
      return existeMembresia(eid) && miMembresia(eid).estado == 'activo';
    }

    function miRol(eid) {
      return miMembresia(eid).rol;
    }

    function tieneRol(eid, roles) {
      return esMiembroActivo(eid) && miRol(eid) in roles;
    }

    function esAdmin(eid) {
      return tieneRol(eid, ['ADMIN_EMPRESA']);
    }

    // Quien puede resolver etapas de aprobación.
    function esAprobador(eid) {
      return tieneRol(eid, ['ADMIN_EMPRESA', 'GERENTE', 'JEFE_AREA', 'SUPERVISOR']);
    }

    // Quien puede definir flujos y cuotas.
    // Ve todo el acervo, no solo lo suyo. Coincide con DOC_VER_TODOS
    // de la matriz de permisos: si una cambia, la otra tiene que cambiar.
    function veTodoElAcervo(eid) {
      return rolEn(eid) in ['admin_empresa', 'gerente', 'jefe_area', 'supervisor'];
    }

    // Ve tambien lo confidencial y lo restringido. DOC_VER_CONFIDENCIAL.
    // El supervisor ve todo el acervo pero no esto: es la diferencia
    // entre revisar el flujo de trabajo y acceder al contenido reservado.
    function veLoReservado(eid) {
      return rolEn(eid) in ['admin_empresa', 'gerente', 'jefe_area'];
    }

    function esGestor(eid) {
      return tieneRol(eid, ['ADMIN_EMPRESA', 'GERENTE', 'JEFE_AREA']);
    }

    // -------------------------------------------
    // PERFIL GLOBAL
    // -------------------------------------------
    // Dice a qué empresa pertenece cada persona. Hay que poder leerlo antes
    // de conocer la empresa, así que no puede colgar de ella.

    match /usuarios/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;

      // Se crea al aceptar una invitación. El vínculo con la empresa no se
      // reescribe desde el cliente: cambiarlo sería saltar de empresa.
      allow create: if autenticado() && request.auth.uid == uid;
      allow update: if autenticado() && request.auth.uid == uid
                    && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    // -------------------------------------------
    // ÍNDICE DE INVITACIONES POR TESTIGO
    // -------------------------------------------
    // Quien acepta una invitación todavía no pertenece a ninguna empresa,
    // así que necesita leer este índice sin estar autenticado. Solo guarda
    // el mínimo para localizar la invitación: empresa, identificador,
    // correo y vencimiento. Conocer el testigo es la credencial.

    match /invitaciones/{token} {

      // Legible sin sesión: quien acepta todavía no tiene cuenta. Conocer
      // el testigo es la credencial, y el testigo es el identificador del
      // documento, así que solo lo lee quien ya lo tiene.
      allow get: if true;

      // Enumerar daría los correos y los roles de toda la plantilla.
      allow list: if false;

      // Antes bastaba estar autenticado, así que una cuenta de cualquier
      // empresa podía crear o reescribir el índice de cualquier otra. Ahora
      // hay que administrar la empresa que se declara en el documento.
      allow create: if esAdmin(request.resource.data.empresaId);

      // Dos vías de actualización, y ninguna más:
      //
      //   quien administra la empresa   → revocar, reenviar
      //   la persona invitada           → marcarla aceptada, y solo eso
      //
      // La segunda se ata al correo del testigo de autenticación: la cuenta
      // recién creada solo puede cerrar SU invitación.
      allow update: if esAdmin(resource.data.empresaId)
                    || (
                      miCorreo() == resource.data.email.lower() &&
                      soloCambia(['estado', 'fechaAceptada']) &&
                      request.resource.data.estado == 'aceptada' &&
                      resource.data.estado == 'pendiente'
                    );

      allow delete: if false;
    }

    // -------------------------------------------
    // EMPRESA
    // -------------------------------------------

    match /empresas/{eid} {

      // La lee cualquier miembro; la edita solo quien administra.
      allow read: if esMiembroActivo(eid);
      allow update: if esAdmin(eid);

      // El alta de empresas no se hace desde el cliente: la crea el
      // aprovisionamiento inicial con credenciales de servidor.
      allow create, delete: if false;

      // ---- Personas ----
      match /miembros/{uid} {
        // Cada persona lee su propia pertenencia aunque aún no esté
        // activa: es como la aplicación descubre que está suspendida.
        allow get: if autenticado() &&
                   (request.auth.uid == uid || esMiembroActivo(eid));
        allow list: if esMiembroActivo(eid);

        // Solo quien administra concede o retira acceso, y nunca sobre sí
        // mismo: el único administrador no puede dejarse fuera.
        allow create: if esAdmin(eid) || request.auth.uid == uid;
        allow update: if esAdmin(eid) && request.auth.uid != uid;
        allow delete: if false;   // se suspende, no se borra
      }

      // ---- Invitaciones ----
      // ---- Invitaciones ----
      //
      // Este documento guarda el testigo en claro, porque quien administra
      // tiene que poder volver a copiar el enlace. Por eso NO lo lee
      // cualquier miembro: con `esMiembroActivo` aquí, un colaborador leía
      // los testigos de las invitaciones pendientes, y una invitación de
      // administrador sin canjear era una escalada de privilegios servida.
      //
      // Quien acepta no lee de aquí: lee del índice público, que lleva lo
      // justo para la pantalla y ningún testigo ajeno.
      match /invitaciones/{id} {
        allow read: if esAdmin(eid);
        allow create: if esAdmin(eid);

        // Igual que en el índice: quien administra, o la persona invitada
        // cerrando la suya.
        allow update: if esAdmin(eid)
                      || (
                        miCorreo() == resource.data.email.lower() &&
                        soloCambia(['estado', 'fechaAceptada']) &&
                        request.resource.data.estado == 'aceptada' &&
                        resource.data.estado == 'pendiente'
                      );

        allow delete: if false;
      }

      // ---- Acervo documental ----
      // ---- Documentos ----
      //
      // La matriz de permisos declara dos recortes de visibilidad y hasta
      // ahora no se aplicaba ninguno: cualquier miembro leia el acervo
      // entero, confidenciales incluidos. El filtro del cliente evita
      // pedir lo que se va a denegar; el que protege es este.
      //
      // Firestore evalua esta regla documento a documento, tambien en las
      // consultas de lista: si un solo resultado no la cumple, rechaza la
      // consulta entera. Por eso el cliente tiene que acotar lo que pide
      // —y por eso un colaborador consulta filtrando por creadoPorUid.
      match /documentos/{id} {
        allow read: if esMiembroActivo(eid) && (
          // Lo mio, siempre.
          resource.data.creadoPorUid == request.auth.uid ||
          (
            veTodoElAcervo(eid) && (
              veLoReservado(eid) ||
              !(resource.data.confidencialidad in ['confidencial', 'restringido'])
            )
          )
        );

        // Al crear se exige que el documento diga quien lo crea, y que sea
        // quien lo esta creando. Sin esto, bastaba omitir el campo para
        // que el documento quedara fuera de toda comprobacion de dueno.
        allow create: if esMiembroActivo(eid) &&
                      request.resource.data.creadoPorUid == request.auth.uid;

        // Editar exige poder ver. Y el dueno no se reescribe: cambiarlo
        // seria apropiarse de un documento ajeno o repudiar el propio.
        allow update: if esMiembroActivo(eid) &&
                      resource.data.creadoPorUid == request.resource.data.creadoPorUid;

        allow delete: if false;   // se archiva, no se borra

        // Los adjuntos siguen la suerte del documento que los contiene.
        match /archivos/{archivoId} {
          allow read, write: if esMiembroActivo(eid);
        }
      }

      match /solicitudes/{id} {
        allow read: if esMiembroActivo(eid);
        allow create: if esMiembroActivo(eid);
        allow update: if esAprobador(eid) ||
                         resource.data.solicitante == miMembresia(eid).nombre;
        allow delete: if false;
      }

      // ---- Flujos y aprobaciones ----
      // ---- Flujos ----
      // Se distinguen dos cosas que viven en la misma colección:
      //
      //   plantilla  → sin documentoId. Define QUIÉN aprueba y en qué
      //                orden. Solo la jefatura la escribe.
      //   expediente → con documentoId. Es el paso de un documento
      //                concreto por una plantilla.
      //
      // Cualquier miembro activo puede abrir un expediente sobre un
      // documento —quien redacta un contrato tiene que poder mandarlo a
      // aprobar—, pero no puede tocar la plantilla, que es donde se
      // decide quién lo aprueba. Sin esta distinción habría que elegir
      // entre que nadie envíe nada o que cualquiera se nombre aprobador.
      match /flujos/{id} {
        allow read: if esMiembroActivo(eid);

        allow create: if esGestor(eid) ||
                      (esMiembroActivo(eid) &&
                       request.resource.data.documentoId is string &&
                       request.resource.data.duplicadoDe is string);

        // El avance del expediente lo escribe el motor de aprobaciones al
        // resolver una etapa: no exige ser gestor, pero sí ser aprobador.
        allow update: if esGestor(eid) ||
                      (esAprobador(eid) && resource.data.documentoId is string);

        allow delete: if false;
      }

      match /tareas/{id} {
        allow read: if esMiembroActivo(eid);

        // El responsable de una etapa tiene que ser alguien que exista en
        // la empresa. Sin esta comprobación, quien abre un expediente
        // podría inventarse un aprobador y firmar su propio documento.
        allow create: if (esGestor(eid) || esMiembroActivo(eid)) &&
                      exists(/databases/$(database)/documents/empresas/$(eid)/miembros/$(request.resource.data.responsableUid));

        // Una etapa la resuelve quien la tiene asignada, o quien
        // administra para poder desatascarla.
        allow update: if esAprobador(eid) &&
                      (resource.data.asignadoUid == request.auth.uid ||
                       resource.data.responsableUid == request.auth.uid ||
                       esAdmin(eid));
        allow delete: if false;
      }

      // ---- Bitácora ----
      // Registro permanente: se añade y se lee, nunca se modifica.
      match /bitacora/{id} {
        allow read: if esMiembroActivo(eid);
        allow create: if esMiembroActivo(eid);
        allow update: if esMiembroActivo(eid) &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['anulado', 'anuladoEl']);
        allow delete: if false;
      }

      // ---- Auditoría ----
      // La evidencia ante una auditoría no se toca una vez escrita.
      match /auditoria/{id} {
        allow read: if esMiembroActivo(eid);
        allow create: if esMiembroActivo(eid);
        allow update, delete: if false;
      }

      // ---- Almacenamiento ----
      match /periodos/{periodoId} {
        allow read: if esMiembroActivo(eid);
        allow write: if esGestor(eid);

        match /{documento=**} {
          allow read: if esMiembroActivo(eid);
          allow write: if esGestor(eid);
        }
      }

      // Cualquier otra subcolección queda denegada por omisión: añadir una
      // exige declararla aquí, y eso es deliberado.
    }
  }
}
